{
  "manifest_version": 3,
  "name": "Screen Ask",
  "version": "1.0.0",
  "description": "Capture a selected area of the current tab and ask AI for an answer.",
  "action": {
    "default_title": "Screen Ask",
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "tabs", "activeTab"],
  "host_permissions": ["https://api.openai.com/*"],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  }
}
